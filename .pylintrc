# pylint 配置。底本：谷歌公开的 Python 风格 pylintrc（github.com/google/styleguide），
# 再加上函数体量检查与阈值。

[MAIN]
jobs=0

[TYPECHECK]
# PySide6 的 QtCore、QtGui、QtWidgets 等模块是编译好的扩展模块。
# pylint 读不到这些模块里的名字，会把存在的名字报成找不到。
# mypy 读 PySide6 随包的 .pyi 类型存根，照样检查用到 PySide6 的代码。
ignored-modules=PySide6

[MESSAGES CONTROL]
# too-few-public-methods 与 too-many-instance-attributes 不查。
# cyclic-import 与 duplicate-code 要把多个模块放在一起比较。
# lint 棘轮给每个文件单独启动一个 pylint 进程，这样的运行报不出这两条。
# 所以这两条在这里关掉，要查它们就对整个仓库运行一次 pylint。
disable=cyclic-import,
        duplicate-code,
        too-few-public-methods,
        too-many-instance-attributes
enable=too-many-lines

[BASIC]
good-names=main,_
no-docstring-rgx=^$
docstring-min-length=-1
method-rgx=^((_?[a-z][a-z0-9_]*)|(__[a-z0-9_]+__)|(visit_[A-Za-z0-9_]+))$

[FORMAT]
indent-string='  '
max-line-length=80
max-module-lines=400
ignore-long-lines=(?x)(^\s*(\#\s*)?<?https?://\S+>?$|^\s*(from\s+\S+\s+)?import\s+.+$)

[DESIGN]
max-args=5
max-positional-arguments=5
max-branches=12
max-locals=15
max-returns=6
max-statements=40
