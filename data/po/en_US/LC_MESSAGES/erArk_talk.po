#: .\data\talk\chara\0248_麦哲伦.csv:73
msgid "“姆唔唔……麻将什么的不太擅长呢。“麦哲伦鼓起了脸颊。\n“因为要好多人和时间来玩嘛。”麦哲伦丧气的说着。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:74
msgid "“是要抽鬼牌吗？”麦哲伦在你身侧探头。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:75
msgid "“嗯！“麦哲伦身体绷紧。\n“博，博士是怎么了吗？”抬起头，麦哲伦满脸紧张的看着你，在得知没事后，才松了一口气。\n“呼，还以为这段时间长胖了……”隐约能听见离开的麦哲伦小声嘀咕着。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:76
msgid "“博士抚摸的手法怪怪的。”麦哲伦小声说着"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:77
msgid "“嗯？博士的手真大呢。”麦哲伦将握住的手举到眼前比划着。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:78
msgid "麦哲伦很开心的反过来给了你一个拥抱。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:79
msgid "“呜啊！”麦哲伦身体一抖，慌忙捂住裙子回头。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:80
msgid "“欸……“麦哲伦露出了不知所措的表情，”博士拿袜子是要做什么？”"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:81
msgid "“好的……我会努力的。“麦哲伦小小的鼓励着自己。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:82
msgid "“哈……“轻轻喘息着，麦哲伦在与你十指相扣后，将手置于胸前。\n“博士满意了吗？“得到回复后，麦哲伦露出了开心的微笑。"
msgstr ""

#: .\data\talk\chara\0248_麦哲伦.csv:83
msgid "“不，不行“麦哲伦陷入了混乱，慌忙的拒绝了你的邀请。"
