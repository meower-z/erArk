#: .\data\talk\obscenity\ask_for_pan.csv:23
msgid "{Name}向{TargetName}索要内裤，{TargetName}拉着你进入了女厕所的隔间，面对面，{TargetName}将{TargetPanName}从身上脱下来交给了你。"
msgstr ""

#: .\data\talk\obscenity\ask_for_pan.csv:24
msgid "{Name}向{TargetName}提出想要内裤的请求，{TargetName}拉着你进入了更衣室的角落并迅速将{TargetPanName}脱下送给了你。"
msgstr ""

#: .\data\talk\obscenity\ask_for_pan.csv:25
msgid "{Name}向{TargetName}提出想要内裤的请求，{TargetName}在更衣室里将{TargetPanName}脱下来交给了你。"
msgstr ""

#: .\data\talk\obscenity\ask_for_pan.csv:26
msgid "{Name}向{TargetName}提出想要内裤的请求，{TargetName}点了点头……\n你注意到脱下{TargetPanName}的{TargetName}，裙子里完全是真空状态。"
msgstr ""

#: .\data\talk\obscenity\ask_for_pan.csv:27
msgid "{Name}向{TargetName}索要胖次，{TargetName}将{TargetPanName}从裙中脱下交给了你。"
msgstr ""

#: .\data\talk\obscenity\ask_for_pan.csv:28
