msgstr ""

#: .\data\talk\chara\0107_雷蛇.csv:206
msgid "“好想排泄……”"
msgstr ""

#: .\data\talk\chara\0107_雷蛇.csv:207
msgid "“感觉这几天的食物快流出来了……”"
msgstr ""

#: .\data\talk\chara\0107_雷蛇.csv:208
